<?xml version="1.0" encoding="utf-8"?>
<!-- Night (dark SYSTEM theme) counterpart of values/styles.xml. The -night
     qualifier is selected automatically from the system uiMode (the DayNight
     parent resolves it at runtime), so the status/navigation bar icon
     foreground flips to LIGHT over the dark windowBackground while the
     panel background itself keeps following the system theme — never the
     in-app (CSS) theme. Overrides AppTheme.NoActionBar wholesale; keep both
     files in sync. -->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
